+    def _needs_retained_drafts(self, scheduler_output: SchedulerOutput) -> bool:
+        """glm53-serve: does a structured-output request of this (non-deferred)
+        step verify drafts the scheduler only knows as -1 placeholders?"""
+        if not (
+            self.check_for_draft_tokens
+            and self.async_scheduling
+            and scheduler_output.has_structured_output_requests
+        ):
+            return False
+        requests = self.scheduler.requests
+        for req_id, spec_tokens in scheduler_output.scheduled_spec_decode_tokens.items():
+            if not spec_tokens or min(spec_tokens) >= 0:
+                continue
+            request = requests.get(req_id)
+            if (
+                request is not None
+                and request.use_structured_output
+                and not request.is_prefill_chunk
+            ):
+                return True
+        return False
+
     def _process_aborts_queue(self):
         if not self.aborts_queue.empty():
             request_ids = []
