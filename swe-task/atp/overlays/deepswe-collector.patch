+def _aggregate_metric_entry(result: dict[str, Any]) -> dict[str, Any]:
+    """Keep native aggregate fields while removing heavyweight rollout payloads."""
+    entry = {
+        key: value
+        for key, value in result.items()
+        if key not in ("response", "responses_create_params", "ng_agent_observations",
+                       "ng_model_call_capture", NG_TRAJECTORY_KEY)
+    }
+    response = result.get("response") or {}
+    response_metadata = {
+        key: response[key] for key in ("usage", "incomplete_details")
+        if response.get(key) is not None
+    }
+    if response_metadata:
+        entry["response"] = response_metadata
+    return entry
+
